{
  "table": "public.bsn_user",
  "columns": {
    "phone": {
      "type": "text",
      "nullable": false,
      "primary_key": true
    },
    "password": {
      "type": "text",
      "nullable": false
    },
    "role": {
      "type": "text",
      "nullable": true,
      "default": "customer"
    },
    "status": {
      "type": "text",
      "nullable": true,
      "default": "active"
    },
    "balance": {
      "type": "jsonb",
      "nullable": false,
      "default": {
        "pending": 0,
        "currency": "text",
        "available": 0
      }
    },
    "personal": {
      "type": "jsonb",
      "nullable": false,
      "default": {
        "email": "text",
        "gender": "text",
        "address": {
          "city": "text",
          "state": "text",
          "country": "text",
          "postcode": "text",
          "address_line": "text"
        },
        "full_name": "text",
        "nationality": "text",
        "date_of_birth": "text"
      }
    },
    "loan": {
      "type": "jsonb",
      "nullable": false,
      "default": {
        "id": "text",
        "amount": 0,
        "status": "text",
        "tenure": 0,
        "approved": false,
        "interest": 0,
        "monthly_payment": 0
      }
    },
    "kyc": {
      "type": "jsonb",
      "nullable": false,
      "default": {
        "status": "text",
        "id_type": "text",
        "full_name": "text",
        "nationality": "text",
        "verified_at": "text",
        "id_image_url": "text",
        "mykad_number": "text",
        "date_of_birth": "text",
        "face_image_url": "text",
        "selfie_image_url": "text"
      }
    },
    "bank": {
      "type": "jsonb",
      "nullable": false,
      "default": {
        "bank_code": "text",
        "bank_name": "text",
        "account_name": "text",
        "account_number": "text"
      }
    },
    "bills": {
      "type": "jsonb",
      "nullable": false,
      "default": [
        {
          "id": "text",
          "fee": 0,
          "name": "text",
          "amount": 0,
          "method_qr": false,
          "method_bank": false,
          "method_qr_url": "text",
          "bill_is_active": false,
          "method_bank_name": "text",
          "method_bank_number": "text"
        }
      ]
    },
    "created_at": {
      "type": "timestamp with time zone",
      "nullable": false,
      "default": "now()"
    },
    "updated_at": {
      "type": "timestamp with time zone",
      "nullable": false,
      "default": "now()"
    }
  },
  "indexes": [
    "bsn_user_personal_email_idx",
    "bsn_user_loan_status_idx",
    "bsn_user_kyc_status_idx"
  ],
  "primary_key": [
    "phone"
  ],
  "trigger": "bsn_user_set_updated_at"
}
